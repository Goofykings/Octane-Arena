# Public-host example. TLS is provided by your host/reverse proxy, not this process.
NODE_ENV=production
HOST=0.0.0.0
# Your host may supply PORT automatically; preserve that assigned value.
PORT=8787
# Exact origins only: no /Octane-Arena/ path, wildcard, or trailing slash.
FRONTEND_ORIGINS=https://goofykings.github.io,http://127.0.0.1:5173,http://localhost:5173
# Enable only when behind a trusted HTTPS reverse proxy.
TRUST_PROXY=false
# Public parties use browser-hosted WebRTC matches. Development/LAN keeps server.
MATCH_TRANSPORT=webrtc
# Optional discovery servers; an empty value permits local-only peer tests.
STUN_URLS=stun:stun.l.google.com:19302
# Configure coturn with REST authentication. Set the same secret privately here
# and on the TURN service. Never put TURN_SECRET in VITE_* or commit a real value.
TURN_URLS=
TURN_SECRET=
# Use relay to verify TURN connectivity; normal play tries direct peers first.
ICE_POLICY=all
