# PeerJS multiplayer uses secure cloud defaults; VITE_API_URL is not required.
# This setting applies only to retained optional/legacy API tooling.
# Do not put passwords, private keys or TURN secrets in frontend environment files.
VITE_API_URL=

# Optional PUBLIC reCAPTCHA Enterprise site key. Enable Firebase App Check after monitoring metrics.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
