# Public backend base URL, without /api/party. Leave empty for local development
# (defaults to http://127.0.0.1:8787) or combined LAN hosting (same page host).
# GitHub Pages: set repository Actions variable VITE_API_URL to your HTTPS backend.
# Example: VITE_API_URL=https://api.example.com
# Alternatively set apiUrl in public/config.json. Vite build setting takes priority.
# No passwords, database credentials or private secrets belong in this file.
VITE_API_URL=
