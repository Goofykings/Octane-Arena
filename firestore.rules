rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /feedbackReports/{reportId} {
      function validReport() {
        let d = request.resource.data;
        return d.keys().hasAll(['username', 'reportType', 'description', 'gameVersion', 'screen', 'mode', 'createdAt'])
          && d.keys().hasOnly(['username', 'reportType', 'description', 'gameVersion', 'screen', 'mode', 'createdAt'])
          && d.username is string && d.username.size() > 0 && d.username.size() <= 20
          && d.username.matches('(?s).*\\S.*')
          && d.reportType in ['Bug', 'Feature Request', 'Other']
          && d.description is string && d.description.size() > 0 && d.description.size() <= 2000
          && d.description.matches('(?s).*\\S.*')
          && d.gameVersion is string && d.gameVersion.size() > 0 && d.gameVersion.size() <= 32
          && d.screen is string && d.screen.size() > 0 && d.screen.size() <= 80
          && d.mode is string && d.mode.size() > 0 && d.mode.size() <= 80
          && d.createdAt is timestamp && d.createdAt == request.time;
      }
      // Local Octane profiles do not use Firebase Auth. Public creation is validated above.
      allow create: if validReport();
      allow read, update, delete: if false;
    }
    match /publishedTrainingPacks/{packDoc} {
      function validPack() {
        let d = request.resource.data;
        return d.keys().hasAll(['packId','ownerUid','authorName','name','version','createdAt','updatedAt','publishedAt','shotCount','shots','published'])
          && d.keys().hasOnly(['packId','ownerUid','authorName','name','version','createdAt','updatedAt','publishedAt','shotCount','shots','published'])
          && d.packId is string && d.packId.size() > 0 && d.packId.size() <= 80
          && d.ownerUid is string && d.ownerUid == request.auth.uid
          && packDoc == d.ownerUid + '_' + d.packId
          && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 20
          && d.authorName.matches('(?s).*\\S.*')
          && d.name is string && d.name.size() > 0 && d.name.size() <= 40 && d.name.matches('(?s).*\\S.*')
          && d.version is int && d.version > 0 && d.version <= 1000000
          && d.createdAt is timestamp && d.updatedAt is timestamp && d.publishedAt is timestamp
          && d.updatedAt == request.time && d.publishedAt == request.time
          && d.published == true
          && d.shotCount is int && d.shotCount >= 1 && d.shotCount <= 50
          && d.shots is list && d.shots.size() == d.shotCount;
      }
      allow get: if (resource == null && request.auth != null && packDoc.matches(request.auth.uid + '_.*'))
        || (resource != null && resource.data.published == true);
      allow list: if resource.data.published == true && request.query.limit != null && request.query.limit <= 21;
      allow create: if request.auth != null && validPack() && request.resource.data.version == 1 && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid && validPack()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.packId == resource.data.packId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
